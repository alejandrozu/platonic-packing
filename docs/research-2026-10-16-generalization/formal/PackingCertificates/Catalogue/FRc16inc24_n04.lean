    allFin 4 (fun j => if (3 : Fin 4) < j then
      planeCheck (record.placement.toCertificate.vertices (3 : Fin 4))
        (record.placement.toCertificate.vertices j)
        (record.placement.separation (3 : Fin 4) j) else true) = true := by decide +kernel

