def source (i : Fin 4) : Cayley.Certificate 4 :=
  rawSources.getD i.val {skew := 0, signs := 0, inverse := 0, rotation := 0}

def record : Barycentric.Certificate 4 4 8 24 6 where
  placement := {
    template := fun p => TemplateData.c16.getD p.val 0
    rotation := fun i => (source i).rotation
    center := fun i => rawCenters.getD i.val 0
    walls := Fin.elim0
    separation := fun i j => (allPlanes.getD i.val #[]).getD (j.val-i.val-1) ⟨0,0,0⟩ }
  containerVertices := fun p => TemplateData.c24.getD p.val 0
  scale := (5023424025997387/4503599627370496 : ℚ)
  containerCenter := ![(0 : ℚ), (0 : ℚ), (0 : ℚ), (0 : ℚ)]
  indices := fun i p => (vertexIndices.getD i.val #[]).getD p.val 0
  weights := fun i p => (vertexWeights.getD i.val #[]).getD p.val 0

def storedScale : ℚ := (5023424025997387/4503599627370496 : ℚ)
def edgeRatio : ℚ := (1 : ℚ)

theorem edge_normalization : edgeRatio = 1 ∧ record.scale = storedScale * edgeRatio := by decide +kernel

theorem template_sizes : TemplateData.c16.size = 8 ∧
    TemplateData.c24.size = 24 := by decide +kernel

theorem input_sizes : rawSources.size = 4 ∧ rawCenters.size = 4 ∧
    allPlanes.size = 4 ∧ vertexIndices.size = 4 ∧ vertexWeights.size = 4 := by decide +kernel

theorem source_piece_0 : Cayley.check (source (0 : Fin 4)) = true := by decide +kernel

theorem gram_piece_0 :
    allFin 4 (fun a => allFin 4 (fun b =>
      decide (qdot (record.placement.rotation (0 : Fin 4) a)
        (record.placement.rotation (0 : Fin 4) b) = if a = b then 1 else 0))) = true := by decide +kernel


theorem pair_row_0 :
    allFin 4 (fun j => if (0 : Fin 4) < j then
      planeCheck (record.placement.toCertificate.vertices (0 : Fin 4))
        (record.placement.toCertificate.vertices j)
        (record.placement.separation (0 : Fin 4) j) else true) = true := by decide +kernel

theorem vertices_piece_0 :
    allFin 8 (fun p => record.vertexCheck (0 : Fin 4) p) = true := by decide +kernel

theorem source_piece_1 : Cayley.check (source (1 : Fin 4)) = true := by decide +kernel

theorem gram_piece_1 :
    allFin 4 (fun a => allFin 4 (fun b =>
      decide (qdot (record.placement.rotation (1 : Fin 4) a)
        (record.placement.rotation (1 : Fin 4) b) = if a = b then 1 else 0))) = true := by decide +kernel


theorem pair_row_1 :
    allFin 4 (fun j => if (1 : Fin 4) < j then
      planeCheck (record.placement.toCertificate.vertices (1 : Fin 4))
        (record.placement.toCertificate.vertices j)
        (record.placement.separation (1 : Fin 4) j) else true) = true := by decide +kernel

theorem vertices_piece_1 :
    allFin 8 (fun p => record.vertexCheck (1 : Fin 4) p) = true := by decide +kernel

theorem source_piece_2 : Cayley.check (source (2 : Fin 4)) = true := by decide +kernel

theorem gram_piece_2 :
    allFin 4 (fun a => allFin 4 (fun b =>
      decide (qdot (record.placement.rotation (2 : Fin 4) a)
        (record.placement.rotation (2 : Fin 4) b) = if a = b then 1 else 0))) = true := by decide +kernel


theorem pair_row_2 :
    allFin 4 (fun j => if (2 : Fin 4) < j then
      planeCheck (record.placement.toCertificate.vertices (2 : Fin 4))
        (record.placement.toCertificate.vertices j)
        (record.placement.separation (2 : Fin 4) j) else true) = true := by decide +kernel

theorem vertices_piece_2 :
    allFin 8 (fun p => record.vertexCheck (2 : Fin 4) p) = true := by decide +kernel

theorem source_piece_3 : Cayley.check (source (3 : Fin 4)) = true := by decide +kernel

theorem gram_piece_3 :
    allFin 4 (fun a => allFin 4 (fun b =>
      decide (qdot (record.placement.rotation (3 : Fin 4) a)
        (record.placement.rotation (3 : Fin 4) b) = if a = b then 1 else 0))) = true := by decide +kernel


