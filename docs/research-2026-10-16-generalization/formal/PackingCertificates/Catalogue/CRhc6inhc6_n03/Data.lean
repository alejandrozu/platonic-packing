  rawSources.getD i.val {skew := 0, signs := 0, inverse := 0, rotation := 0}

def record : Barycentric.Certificate 6 3 64 64 8 where
  placement := {
    template := fun p => TemplateData.hc6.getD p.val 0
    rotation := fun i => (source i).rotation
