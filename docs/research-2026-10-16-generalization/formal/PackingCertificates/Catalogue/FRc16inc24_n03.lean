def source (i : Fin 3) : Cayley.Certificate 4 :=
  rawSources.getD i.val {skew := 0, signs := 0, inverse := 0, rotation := 0}

def record : Barycentric.Certificate 4 3 8 24 6 where
  placement := {
    template := fun p => TemplateData.c16.getD p.val 0
    rotation := fun i => (source i).rotation
    center := fun i => rawCenters.getD i.val 0
    walls := Fin.elim0
    separation := fun i j => (allPlanes.getD i.val #[]).getD (j.val-i.val-1) ⟨0,0,0⟩ }
  containerVertices := fun p => TemplateData.c24.getD p.val 0
  scale := (4503600837491769/4503599627370496 : ℚ)
  containerCenter := ![(0 : ℚ), (0 : ℚ), (0 : ℚ), (0 : ℚ)]
  indices := fun i p => (vertexIndices.getD i.val #[]).getD p.val 0
  weights := fun i p => (vertexWeights.getD i.val #[]).getD p.val 0

def storedScale : ℚ := (4503600837491769/4503599627370496 : ℚ)
def edgeRatio : ℚ := (1 : ℚ)

theorem edge_normalization : edgeRatio = 1 ∧ record.scale = storedScale * edgeRatio := by decide +kernel

theorem template_sizes : TemplateData.c16.size = 8 ∧
    TemplateData.c24.size = 24 := by decide +kernel

theorem input_sizes : rawSources.size = 3 ∧ rawCenters.size = 3 ∧
    allPlanes.size = 3 ∧ vertexIndices.size = 3 ∧ vertexWeights.size = 3 := by decide +kernel

theorem source_piece_0 : Cayley.check (source (0 : Fin 3)) = true := by decide +kernel

theorem gram_piece_0 :
    allFin 4 (fun a => allFin 4 (fun b =>
      decide (qdot (record.placement.rotation (0 : Fin 3) a)
        (record.placement.rotation (0 : Fin 3) b) = if a = b then 1 else 0))) = true := by decide +kernel


theorem pair_row_0 :
    allFin 3 (fun j => if (0 : Fin 3) < j then
      planeCheck (record.placement.toCertificate.vertices (0 : Fin 3))
        (record.placement.toCertificate.vertices j)
        (record.placement.separation (0 : Fin 3) j) else true) = true := by decide +kernel

theorem vertices_piece_0 :
    allFin 8 (fun p => record.vertexCheck (0 : Fin 3) p) = true := by decide +kernel

theorem source_piece_1 : Cayley.check (source (1 : Fin 3)) = true := by decide +kernel

theorem gram_piece_1 :
    allFin 4 (fun a => allFin 4 (fun b =>
      decide (qdot (record.placement.rotation (1 : Fin 3) a)
        (record.placement.rotation (1 : Fin 3) b) = if a = b then 1 else 0))) = true := by decide +kernel


theorem pair_row_1 :
    allFin 3 (fun j => if (1 : Fin 3) < j then
      planeCheck (record.placement.toCertificate.vertices (1 : Fin 3))
        (record.placement.toCertificate.vertices j)
        (record.placement.separation (1 : Fin 3) j) else true) = true := by decide +kernel

theorem vertices_piece_1 :
    allFin 8 (fun p => record.vertexCheck (1 : Fin 3) p) = true := by decide +kernel

theorem source_piece_2 : Cayley.check (source (2 : Fin 3)) = true := by decide +kernel

theorem gram_piece_2 :
    allFin 4 (fun a => allFin 4 (fun b =>
      decide (qdot (record.placement.rotation (2 : Fin 3) a)
        (record.placement.rotation (2 : Fin 3) b) = if a = b then 1 else 0))) = true := by decide +kernel


theorem pair_row_2 :
    allFin 3 (fun j => if (2 : Fin 3) < j then
      planeCheck (record.placement.toCertificate.vertices (2 : Fin 3))
        (record.placement.toCertificate.vertices j)
        (record.placement.separation (2 : Fin 3) j) else true) = true := by decide +kernel

theorem vertices_piece_2 :
    allFin 8 (fun p => record.vertexCheck (2 : Fin 3) p) = true := by decide +kernel

theorem source_checked : allFin 3 (fun i => Cayley.check (source i)) = true := by
  apply allFin_eq_true.mpr
  intro i
  fin_cases i
  · exact source_piece_0
  · exact source_piece_1
  · exact source_piece_2

theorem gram_checked_all : allFin 3 (fun i => allFin 4 (fun a => allFin 4 (fun b => decide (qdot (record.placement.rotation i a) (record.placement.rotation i b) = if a = b then 1 else 0)))) = true := by
  apply allFin_eq_true.mpr
  intro i
  fin_cases i
  · exact gram_piece_0
  · exact gram_piece_1
  · exact gram_piece_2

theorem pair_checked : allFin 3 (fun i => allFin 3 (fun j => if i < j then planeCheck (record.placement.toCertificate.vertices i) (record.placement.toCertificate.vertices j) (record.placement.separation i j) else true)) = true := by
  apply allFin_eq_true.mpr
  intro i
  fin_cases i
  · exact pair_row_0
  · exact pair_row_1
  · exact pair_row_2

theorem vertices_checked : allFin 3 (fun i => allFin 8 (fun p => record.vertexCheck i p)) = true := by
  apply allFin_eq_true.mpr
  intro i
  fin_cases i
  · exact vertices_piece_0
  · exact vertices_piece_1
  · exact vertices_piece_2

theorem source_valid : ∀ i, Cayley.Valid (source i) := by
  intro i
  exact Cayley.check_sound _ (allFin_eq_true.mp source_checked i)

theorem gram_checked : orthogonalCheck record.placement = true := gram_checked_all

theorem walls_checked :
    allFin 3 (fun i => allFin 8 (fun p => allFin 0 (fun f =>
      decide (qdot (record.placement.toCertificate.walls f).normal
        (record.placement.toCertificate.vertices i p) ≤
          (record.placement.toCertificate.walls f).offset)))) = true := by
  apply allFin_eq_true.mpr
  intro i
  apply allFin_eq_true.mpr
  intro p
  apply allFin_eq_true.mpr
  intro f
  exact Fin.elim0 f

theorem rational_checked : Rational.check record.placement.toCertificate = true := by
  simp only [Rational.check, Bool.and_eq_true]
  exact ⟨walls_checked, pair_checked⟩

theorem placed_checked : checkPlaced record.placement = true := by
  simp only [checkPlaced, Bool.and_eq_true]
  exact ⟨gram_checked, rational_checked⟩

theorem scale_checked : decide (0 < record.scale) = true := by decide +kernel

theorem checked : Barycentric.check record = true := by
  simp only [Barycentric.check, Bool.and_eq_true]
  exact ⟨⟨placed_checked, scale_checked⟩, vertices_checked⟩

/-- Complete convex-polytope packing, assembled from kernel-checked fragments. -/
theorem packing : Barycentric.Valid record := Barycentric.check_sound record checked

theorem proper_orientation : ∀ i : Fin 3,
    Matrix.det (fun a b => (record.placement.rotation i a b : ℝ)) = 1 := by
  intro i
  exact Cayley.determinant_real (source i) (allFin_eq_true.mp source_checked i)

#print axioms source_valid
#print axioms packing
#print axioms proper_orientation
