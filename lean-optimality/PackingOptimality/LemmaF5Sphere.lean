/-- Five coordinates with `sᵢ² ≤ 9/20`, λ = 29/70: `Σ (sᵢ³ + λ sᵢ) ≤ 99/70` (the maximum is ≈ 1.40607). -/
theorem cs5 (s0 s1 s2 s3 s4 : ℝ) (h0 : 0 ≤ s0) (h1 : 0 ≤ s1) (h2 : 0 ≤ s2) (h3 : 0 ≤ s3) (h4 : 0 ≤ s4) (c0 : s0 ^ 2 ≤ (9 / 20 : ℝ)) (c1 : s1 ^ 2 ≤ (9 / 20 : ℝ)) (c2 : s2 ^ 2 ≤ (9 / 20 : ℝ)) (c3 : s3 ^ 2 ≤ (9 / 20 : ℝ)) (c4 : s4 ^ 2 ≤ (9 / 20 : ℝ))
    (hs : s0 ^ 2 + s1 ^ 2 + s2 ^ 2 + s3 ^ 2 + s4 ^ 2 = 1) :
    (s0 ^ 3 + (29 / 70 : ℝ) * s0) + (s1 ^ 3 + (29 / 70 : ℝ) * s1) + (s2 ^ 3 + (29 / 70 : ℝ) * s2) + (s3 ^ 3 + (29 / 70 : ℝ) * s3) + (s4 ^ 3 + (29 / 70 : ℝ) * s4) ≤ (99 / 70 : ℝ) := by
  rcases le_total s1 s0 with w1 | w1
  · rcases le_total s2 s0 with w2 | w2
    · rcases le_total s3 s0 with w3 | w3
      · rcases le_total s4 s0 with w4 | w4
        · have := cs5_core s0 s1 s2 s3 s4 h0 h1 h2 h3 h4 (by linarith) (by linarith) (by linarith) (by linarith) c0 c1 c2 c3 c4 (by linarith)
          linarith
        · have := cs5_core s4 s0 s1 s2 s3 h4 h0 h1 h2 h3 (by linarith) (by linarith) (by linarith) (by linarith) c4 c0 c1 c2 c3 (by linarith)
          linarith
      · rcases le_total s4 s3 with w4 | w4
        · have := cs5_core s3 s0 s1 s2 s4 h3 h0 h1 h2 h4 (by linarith) (by linarith) (by linarith) (by linarith) c3 c0 c1 c2 c4 (by linarith)
          linarith
        · have := cs5_core s4 s0 s1 s2 s3 h4 h0 h1 h2 h3 (by linarith) (by linarith) (by linarith) (by linarith) c4 c0 c1 c2 c3 (by linarith)
          linarith
    · rcases le_total s3 s2 with w3 | w3
      · rcases le_total s4 s2 with w4 | w4
        · have := cs5_core s2 s0 s1 s3 s4 h2 h0 h1 h3 h4 (by linarith) (by linarith) (by linarith) (by linarith) c2 c0 c1 c3 c4 (by linarith)
          linarith
        · have := cs5_core s4 s0 s1 s2 s3 h4 h0 h1 h2 h3 (by linarith) (by linarith) (by linarith) (by linarith) c4 c0 c1 c2 c3 (by linarith)
          linarith
      · rcases le_total s4 s3 with w4 | w4
        · have := cs5_core s3 s0 s1 s2 s4 h3 h0 h1 h2 h4 (by linarith) (by linarith) (by linarith) (by linarith) c3 c0 c1 c2 c4 (by linarith)
          linarith
        · have := cs5_core s4 s0 s1 s2 s3 h4 h0 h1 h2 h3 (by linarith) (by linarith) (by linarith) (by linarith) c4 c0 c1 c2 c3 (by linarith)
          linarith
  · rcases le_total s2 s1 with w2 | w2
    · rcases le_total s3 s1 with w3 | w3
      · rcases le_total s4 s1 with w4 | w4
        · have := cs5_core s1 s0 s2 s3 s4 h1 h0 h2 h3 h4 (by linarith) (by linarith) (by linarith) (by linarith) c1 c0 c2 c3 c4 (by linarith)
          linarith
        · have := cs5_core s4 s0 s1 s2 s3 h4 h0 h1 h2 h3 (by linarith) (by linarith) (by linarith) (by linarith) c4 c0 c1 c2 c3 (by linarith)
          linarith
      · rcases le_total s4 s3 with w4 | w4
        · have := cs5_core s3 s0 s1 s2 s4 h3 h0 h1 h2 h4 (by linarith) (by linarith) (by linarith) (by linarith) c3 c0 c1 c2 c4 (by linarith)
          linarith
        · have := cs5_core s4 s0 s1 s2 s3 h4 h0 h1 h2 h3 (by linarith) (by linarith) (by linarith) (by linarith) c4 c0 c1 c2 c3 (by linarith)
          linarith
    · rcases le_total s3 s2 with w3 | w3
      · rcases le_total s4 s2 with w4 | w4
        · have := cs5_core s2 s0 s1 s3 s4 h2 h0 h1 h3 h4 (by linarith) (by linarith) (by linarith) (by linarith) c2 c0 c1 c3 c4 (by linarith)
