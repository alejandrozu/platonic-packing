      · have := sphA_core s0 s1 s2 s3 h0 h1 h2 h3 (by linarith) (by linarith) (by linarith) (by linarith)
        linarith
      · have := sphA_core s3 s0 s1 s2 h3 h0 h1 h2 (by linarith) (by linarith) (by linarith) (by linarith)
