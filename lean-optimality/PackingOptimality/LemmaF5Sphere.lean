theorem cs5S_2 (s : ℝ) (hs : 0 ≤ s) (hlo : (356409 / 1000000 : ℝ) ≤ s ^ 2) (hhi : s ^ 2 ≤ (45010681 / 100000000 : ℝ)) :
    s ^ 3 + (29 / 70 : ℝ) * s ≤ (3857434368297 / 887530000000000 : ℝ) + (1134930177 / 887530000 : ℝ) * s ^ 2 := by
