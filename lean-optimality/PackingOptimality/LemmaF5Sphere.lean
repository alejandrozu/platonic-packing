theorem cs5_core (s0 s1 s2 s3 s4 : ℝ) (h0 : 0 ≤ s0) (h1 : 0 ≤ s1) (h2 : 0 ≤ s2) (h3 : 0 ≤ s3) (h4 : 0 ≤ s4)
    (o1 : s1 ≤ s0) (o2 : s2 ≤ s0) (o3 : s3 ≤ s0) (o4 : s4 ≤ s0) (c0 : s0 ^ 2 ≤ (9 / 20 : ℝ)) (c1 : s1 ^ 2 ≤ (9 / 20 : ℝ)) (c2 : s2 ^ 2 ≤ (9 / 20 : ℝ)) (c3 : s3 ^ 2 ≤ (9 / 20 : ℝ)) (c4 : s4 ^ 2 ≤ (9 / 20 : ℝ))
    (hs : s0 ^ 2 + s1 ^ 2 + s2 ^ 2 + s3 ^ 2 + s4 ^ 2 = 1) :
    (s0 ^ 3 + (29 / 70 : ℝ) * s0) + (s1 ^ 3 + (29 / 70 : ℝ) * s1) + (s2 ^ 3 + (29 / 70 : ℝ) * s2) + (s3 ^ 3 + (29 / 70 : ℝ) * s3) + (s4 ^ 3 + (29 / 70 : ℝ) * s4) ≤ (99 / 70 : ℝ) := by
  have q1 : s1 ^ 2 ≤ s0 ^ 2 := by nlinarith
  have q2 : s2 ^ 2 ≤ s0 ^ 2 := by nlinarith
  have q3 : s3 ^ 2 ≤ s0 ^ 2 := by nlinarith
  have q4 : s4 ^ 2 ≤ s0 ^ 2 := by nlinarith
  have b0 : (199809 / 1000000 : ℝ) ≤ s0 ^ 2 := by nlinarith
  have t0 : s0 ^ 2 ≤ (45010681 / 100000000 : ℝ) := by nlinarith
  have t1 : s1 ^ 2 ≤ (45010681 / 100000000 : ℝ) := by nlinarith
  have t2 : s2 ^ 2 ≤ (45010681 / 100000000 : ℝ) := by nlinarith
  have t3 : s3 ^ 2 ≤ (45010681 / 100000000 : ℝ) := by nlinarith
  have t4 : s4 ^ 2 ≤ (45010681 / 100000000 : ℝ) := by nlinarith
  have F0 := cs5B_cases s0 h0 b0 t0
  have F1 := cs5S_cases s1 h1 t1
  have F2 := cs5S_cases s2 h2 t2
  have F3 := cs5S_cases s3 h3 t3
  have F4 := cs5S_cases s4 h4 t4
  have e0 := sq_nonneg s0
  have e1 := sq_nonneg s1
  have e2 := sq_nonneg s2
  have e3 := sq_nonneg s3
  have e4 := sq_nonneg s4
  clear * - hs q1 q2 q3 q4 e0 e1 e2 e3 e4 F0 F1 F2 F3 F4
  generalize s0 ^ 2 = Q0 at *
  generalize s0 ^ 3 = C0 at *
  generalize s1 ^ 2 = Q1 at *
  generalize s1 ^ 3 = C1 at *
  generalize s2 ^ 2 = Q2 at *
  generalize s2 ^ 3 = C2 at *
  generalize s3 ^ 2 = Q3 at *
  generalize s3 ^ 3 = C3 at *
  generalize s4 ^ 2 = Q4 at *
  generalize s4 ^ 3 = C4 at *
  rcases F0 with ⟨a0_0, b0_0, f0_0⟩ | ⟨a0_1, b0_1, f0_1⟩ <;>
  rcases F1 with ⟨b1_0, f1_0⟩ | ⟨a1_1, b1_1, f1_1⟩ | ⟨a1_2, b1_2, f1_2⟩ <;>
  rcases F2 with ⟨b2_0, f2_0⟩ | ⟨a2_1, b2_1, f2_1⟩ | ⟨a2_2, b2_2, f2_2⟩ <;>
  rcases F3 with ⟨b3_0, f3_0⟩ | ⟨a3_1, b3_1, f3_1⟩ | ⟨a3_2, b3_2, f3_2⟩ <;>
  rcases F4 with ⟨b4_0, f4_0⟩ | ⟨a4_1, b4_1, f4_1⟩ | ⟨a4_2, b4_2, f4_2⟩ <;>
  linarith

