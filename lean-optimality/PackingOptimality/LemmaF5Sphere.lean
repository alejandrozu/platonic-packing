theorem cs5B_cases (s : ℝ) (hs : 0 ≤ s) (hlo : (199809 / 1000000 : ℝ) ≤ s ^ 2) (hcap : s ^ 2 ≤ (45010681 / 100000000 : ℝ)) :
    ((199809 / 1000000 : ℝ) ≤ s ^ 2 ∧ s ^ 2 ≤ (90601 / 250000 : ℝ) ∧ s ^ 3 + (29 / 70 : ℝ) * s ≤ (9767554791 / 262250000000 : ℝ) + (8719149 / 7343000 : ℝ) * s ^ 2) ∨
